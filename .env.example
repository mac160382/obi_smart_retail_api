APP_NAME=Smart Retail Lácteos API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://smartadmin:change-me@localhost:5432/smart_retail

DATABASE_SCHEMA=public
HISTORICAL_SALES_TABLE=lacteos_ventas_historicas
CURRENT_PROMOTIONS_SCHEMA=public
CURRENT_PROMOTIONS_TABLE=g2_lacteos_promociones_vigentes
CURRENT_PROMOTIONS_VIEW_SCHEMA=public
CURRENT_PROMOTIONS_VIEW=vst_promociones_vigentes
INVENTORY_MASTER_SCHEMA=public
INVENTORY_MASTER_TABLE=g2_maestro_inventario_lacteos
ITEMS_MASTER_SCHEMA=public
ITEMS_MASTER_TABLE=lacteos_maestro_items
STORES_MASTER_SCHEMA=public
STORES_MASTER_TABLE=lacteos_maestro_tiendas
FORECAST_SCHEMA=public
FORECAST_TABLE=pronostico
SUGGESTED_ORDERS_SCHEMA=public
SUGGESTED_ORDERS_TABLE=pedido_sugerido
DATABASE_OWNER=smartadmin

JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081"]

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=smartretail
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
RABBITMQ_VIRTUAL_HOST=smart_retail
RABBITMQ_EXCHANGE=smart_retail.events
RABBITMQ_QUEUE=jaimito
RABBITMQ_HISTORICAL_SALES_ROUTING_KEY=historical_sales.imported
RABBITMQ_FORECAST_LOADED_QUEUE=smart_retail.forecast.loaded
RABBITMQ_FORECAST_LOADED_ROUTING_KEY=forecast.loaded
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10

SSE_HEARTBEAT_SECONDS=15
SSE_CLIENT_QUEUE_SIZE=100
SSE_REPLAY_LIMIT=1000

MAX_UPLOAD_SIZE_MB=20
CSV_ENCODING=utf-8-sig
CSV_DELIMITER=,
CSV_BATCH_SIZE=1000

# Asistente LLM (deshabilitado por defecto para una activación incremental)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ASSISTANT_ENABLED=false
ASSISTANT_REAL_LLM_ENABLED=false
ASSISTANT_ENABLED_TOOLS=consultar_pedidos_sugeridos,consultar_pronosticos,consultar_articulos,consultar_tiendas,consultar_ventas,consultar_inventario,consultar_parametros,consultar_promociones,consultar_ejecuciones
ASSISTANT_MAX_RECORDS=25
ASSISTANT_MAX_TOOL_CALLS=6
ASSISTANT_MAX_MODEL_CALLS=4
ASSISTANT_DEFAULT_FORECAST_ORIGIN=2026-06-24
ASSISTANT_EXECUTION_DIR=resources/executions
